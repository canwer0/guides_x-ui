#!/usr/bin/env bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[OK]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
bad()  { echo -e "${RED}[FAIL]${NC} $*"; }
info() { echo -e "${BLUE}[*]${NC} $*"; }

echo
echo "======================================"
echo " Диагностика входного/выходного сервера"
echo "======================================"
echo

# ----------------------------------
# Основной IP / интерфейс / gateway
# ----------------------------------

DEFAULT_ROUTE=$(ip -4 route show default | head -n1)

IFACE=$(awk '{
    for(i=1;i<=NF;i++)
        if($i=="dev") print $(i+1)
}' <<< "$DEFAULT_ROUTE")

GATEWAY=$(awk '{
    for(i=1;i<=NF;i++)
        if($i=="via") print $(i+1)
}' <<< "$DEFAULT_ROUTE")

LOCAL_IP=$(ip -4 route get 1.1.1.1 2>/dev/null \
    | awk '{
        for(i=1;i<=NF;i++)
            if($i=="src") {
                print $(i+1)
                exit
            }
    }')

if [[ -z "$LOCAL_IP" && -n "$IFACE" ]]; then
    LOCAL_IP=$(ip -4 addr show dev "$IFACE" \
        | awk '/inet / {print $2}' \
        | cut -d/ -f1 \
        | head -n1)
fi

echo "Текущий сервер:"
echo "  IP:        ${LOCAL_IP:-НЕ ОПРЕДЕЛЁН}"
echo "  Интерфейс: ${IFACE:-НЕ ОПРЕДЕЛЁН}"
echo "  Gateway:   ${GATEWAY:-НЕ ОПРЕДЕЛЁН}"
echo

read -rp "Этот сервер [1] ВХОДНОЙ или [2] ВЫХОДНОЙ? " ROLE

case "$ROLE" in
    1)
        LOCAL_ROLE="ВХОДНОЙ"
        PEER_ROLE="ВЫХОДНОЙ"
        ;;
    2)
        LOCAL_ROLE="ВЫХОДНОЙ"
        PEER_ROLE="ВХОДНОЙ"
        ;;
    *)
        LOCAL_ROLE="ТЕКУЩИЙ"
        PEER_ROLE="СВЯЗАННЫЙ"
        ;;
esac

echo
read -rp "IP связанного сервера: " PEER_IP

echo
echo "Укажите ЛОКАЛЬНЫЕ inbound-порты этого сервера."
echo "То есть порты, которые должны слушаться на $LOCAL_IP."
echo "Можно несколько через пробел или запятую."
echo "Пример: 41792,443,8443"
read -rp "> " LOCAL_PORTS_RAW

echo
echo "Укажите inbound-порты СВЯЗАННОГО сервера."
echo "То есть порты, которые должны быть доступны на $PEER_IP."
echo "Можно несколько через пробел или запятую."
echo "Пример: 52843,443,8443"
read -rp "> " REMOTE_PORTS_RAW

# Запятые -> пробелы
LOCAL_PORTS_RAW="${LOCAL_PORTS_RAW//,/ }"
REMOTE_PORTS_RAW="${REMOTE_PORTS_RAW//,/ }"

read -ra LOCAL_PORTS <<< "$LOCAL_PORTS_RAW"
read -ra REMOTE_PORTS <<< "$REMOTE_PORTS_RAW"

echo
echo "======================================"
echo "             КОНФИГУРАЦИЯ"
echo "======================================"
echo
echo "$LOCAL_ROLE:"
echo "  IP:     $LOCAL_IP"
echo "  Порты:  ${LOCAL_PORTS[*]:-(не указаны)}"
echo
echo "$PEER_ROLE:"
echo "  IP:     $PEER_IP"
echo "  Порты:  ${REMOTE_PORTS[*]:-(не указаны)}"
echo

LOCAL_FAIL=0
REMOTE_FAIL=0
REMOTE_OK=0
REMOTE_REFUSED=0
REMOTE_TIMEOUT=0

# ----------------------------------
# Проверка маршрута
# ----------------------------------

info "Проверяю маршрут до $PEER_IP..."

ROUTE=$(ip -4 route get "$PEER_IP" 2>&1)
ROUTE_RC=$?

if [[ $ROUTE_RC -ne 0 ]]; then
    bad "Маршрут до $PEER_IP не найден."
    echo "$ROUTE"
    ROUTE_FAIL=1
else
    echo "    $ROUTE"

    ROUTE_SRC=$(awk '{
        for(i=1;i<=NF;i++)
            if($i=="src") {
                print $(i+1)
                exit
            }
    }' <<< "$ROUTE")

    if [[ -n "$ROUTE_SRC" && "$ROUTE_SRC" != "$LOCAL_IP" ]]; then
        bad "Трафик идёт с source IP $ROUTE_SRC"
        bad "Основной IP сервера: $LOCAL_IP"
        ROUTE_FAIL=1
    else
        ok "Маршрут использует source IP $LOCAL_IP"
        ROUTE_FAIL=0
    fi
fi

# ----------------------------------
# Ping
# ----------------------------------

echo
info "Проверяю доступность $PEER_IP..."

if ping -I "$LOCAL_IP" -c 2 -W 2 "$PEER_IP" >/dev/null 2>&1; then
    ok "$PEER_ROLE отвечает на ping."
    PING_OK=1
else
    warn "$PEER_ROLE не отвечает на ping."
    warn "ICMP может быть запрещён firewall, поэтому продолжаю TCP-проверку."
    PING_OK=0
fi

# ----------------------------------
# ЛОКАЛЬНЫЕ inbound-порты
# ----------------------------------

echo
echo "======================================"
echo "        ЛОКАЛЬНЫЕ INBOUND-ПОРТЫ"
echo "======================================"
echo

if [[ ${#LOCAL_PORTS[@]} -eq 0 ]]; then

    warn "Локальные порты не указаны."

else

    for PORT in "${LOCAL_PORTS[@]}"; do

        [[ -z "$PORT" ]] && continue

        if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
            bad "Некорректный порт: $PORT"
            LOCAL_FAIL=$((LOCAL_FAIL + 1))
            continue
        fi

        LISTEN_LINE=$(ss -lntup 2>/dev/null \
            | awk -v port="$PORT" '
              $5 ~ ":" port "$" {
                  print
                  exit
              }')

        if [[ -n "$LISTEN_LINE" ]]; then

            ok "Локальный порт $PORT слушается."
            echo "    $LISTEN_LINE"

            if grep -q "127.0.0.1:$PORT" <<< "$LISTEN_LINE"; then
                warn "Порт $PORT слушается только на 127.0.0.1."
                warn "Снаружи он может быть недоступен."
            fi

        else

            bad "Локальный inbound-порт $PORT НЕ слушается."
            LOCAL_FAIL=$((LOCAL_FAIL + 1))

        fi

        echo

    done
fi

# ----------------------------------
# УДАЛЁННЫЕ inbound-порты
# ----------------------------------

echo
echo "======================================"
echo "        УДАЛЁННЫЕ INBOUND-ПОРТЫ"
echo "======================================"
echo

if [[ ${#REMOTE_PORTS[@]} -eq 0 ]]; then

    warn "Удалённые порты не указаны."

else

    for PORT in "${REMOTE_PORTS[@]}"; do

        [[ -z "$PORT" ]] && continue

        if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
            bad "Некорректный порт: $PORT"
            continue
        fi

        info "Проверяю $PEER_IP:$PORT..."

        if command -v nc >/dev/null 2>&1; then

            RESULT=$(nc -vz -w 4 -s "$LOCAL_IP" "$PEER_IP" "$PORT" 2>&1)
            RC=$?

            if [[ $RC -eq 0 ]]; then

                ok "$PEER_IP:$PORT ДОСТУПЕН"
                REMOTE_OK=$((REMOTE_OK + 1))

            elif grep -qi "refused" <<< "$RESULT"; then

                bad "$PEER_IP:$PORT — CONNECTION REFUSED"
                echo "    Сервер доступен, но на порту никто не принимает соединение."
                REMOTE_REFUSED=$((REMOTE_REFUSED + 1))
                REMOTE_FAIL=$((REMOTE_FAIL + 1))

            elif grep -qiE "timed out|operation now in progress" <<< "$RESULT"; then

                bad "$PEER_IP:$PORT — TIMEOUT"
                echo "    Возможна фильтрация firewall / ACL / провайдером."
                REMOTE_TIMEOUT=$((REMOTE_TIMEOUT + 1))
                REMOTE_FAIL=$((REMOTE_FAIL + 1))

            else

                bad "$PEER_IP:$PORT — соединение не установлено."
                echo "    $RESULT"
                REMOTE_FAIL=$((REMOTE_FAIL + 1))

            fi

        else

            warn "nc не установлен."
            warn "Установить: apt install netcat-openbsd"

        fi

        echo

    done
fi

# ----------------------------------
# Итог
# ----------------------------------

echo
echo "======================================"
echo "                ИТОГ"
echo "======================================"
echo

echo "Локальный сервер:"
echo "  $LOCAL_ROLE $LOCAL_IP"

if (( LOCAL_FAIL == 0 )); then
    ok "Все указанные локальные inbound-порты слушаются."
else
    bad "Не работают локальные порты: $LOCAL_FAIL шт."
fi

echo
echo "Связанный сервер:"
echo "  $PEER_ROLE $PEER_IP"
echo
echo "  Доступно портов:           $REMOTE_OK"
echo "  Connection refused:        $REMOTE_REFUSED"
echo "  Timeout / фильтрация:      $REMOTE_TIMEOUT"
echo

if (( LOCAL_FAIL > 0 )); then

    bad "Есть проблема на $LOCAL_ROLE."
    echo
    echo "Часть локальных inbound-портов не слушается."
    echo "Проверь Xray / x-ui / inbound-конфигурацию."
    echo
    echo "Полезные команды:"
    echo "  ss -lntup"
    echo "  systemctl status x-ui"
    echo "  systemctl status xray"

fi

if (( REMOTE_REFUSED > 0 )); then

    echo
    bad "На $PEER_ROLE есть порты с CONNECTION REFUSED."
    echo
    echo "Это означает:"
    echo "  сервер доступен;"
    echo "  TCP-пакет до него доходит;"
    echo "  но указанный порт не слушается либо firewall делает REJECT."

fi

if (( REMOTE_TIMEOUT > 0 )); then

    echo
    bad "Есть TIMEOUT в направлении:"
    echo
    echo "  $LOCAL_ROLE"
    echo "  $LOCAL_IP"
    echo "       ↓"
    echo "  $PEER_ROLE"
    echo "  $PEER_IP"
    echo
    echo "Возможные причины:"
    echo "  • firewall на $PEER_ROLE;"
    echo "  • iptables/nftables;"
    echo "  • ACL у провайдера;"
    echo "  • фильтрация конкретного source IP;"
    echo "  • проблема маршрута."

fi

if (( LOCAL_FAIL == 0 && REMOTE_FAIL == 0 && REMOTE_OK > 0 )); then

    echo
    ok "СЕТЕВАЯ ПРОВЕРКА УСПЕШНА."
    echo
    echo "Локальные inbound-порты слушаются,"
    echo "удалённые inbound-порты доступны."
    echo
    echo "Если связка Xray всё равно не работает —"
    echo "проверяй outbound/routing/UUID/protocol/Reality/SNI/ключи."

fi

echo
echo "======================================"
