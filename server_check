#!/usr/bin/env bash

# server-check.sh
# Проверка связи между входным и выходным сервером.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[OK]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
bad()  { echo -e "${RED}[FAIL]${NC} $*"; }
info() { echo -e "${BLUE}[*]${NC} $*"; }

echo
echo "======================================"
echo " Диагностика входного/выходного сервера"
echo "======================================"
echo

# ------------------------------
# Определяем основной интерфейс/IP
# ------------------------------

DEFAULT_ROUTE=$(ip -4 route show default | head -n1)
IFACE=$(awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' <<< "$DEFAULT_ROUTE")
GATEWAY=$(awk '{for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' <<< "$DEFAULT_ROUTE")

LOCAL_IP=$(ip -4 route get 1.1.1.1 2>/dev/null \
    | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}')

if [[ -z "$LOCAL_IP" && -n "$IFACE" ]]; then
    LOCAL_IP=$(ip -4 addr show dev "$IFACE" \
        | awk '/inet / {print $2}' \
        | cut -d/ -f1 \
        | head -n1)
fi

echo "Текущий сервер:"
echo "  IP:        ${LOCAL_IP:-НЕ ОПРЕДЕЛЁН}"
echo "  Интерфейс: ${IFACE:-НЕ ОПРЕДЕЛЁН}"
echo "  Gateway:   ${GATEWAY:-НЕ ОПРЕДЕЛЁН}"
echo

read -rp "Этот сервер [1] входной или [2] выходной? " ROLE

case "$ROLE" in
    1)
        LOCAL_ROLE="ВХОДНОЙ"
        PEER_ROLE="ВЫХОДНОЙ"
        ;;
    2)
        LOCAL_ROLE="ВЫХОДНОЙ"
        PEER_ROLE="ВХОДНОЙ"
        ;;
    *)
        LOCAL_ROLE="ТЕКУЩИЙ"
        PEER_ROLE="ВТОРОЙ"
        ;;
esac

read -rp "IP связанного сервера: " PEER_IP
read -rp "Порт сервиса для проверки (Enter = пропустить): " SERVICE_PORT

echo
echo "--------------------------------------"
echo "$LOCAL_ROLE: $LOCAL_IP"
echo "$PEER_ROLE:  $PEER_IP"
echo "--------------------------------------"
echo

LOCAL_ERROR=0
PEER_ERROR=0
LINK_ERROR=0

# ------------------------------
# 1. Проверяем локальный IP
# ------------------------------

info "Проверяю локальную конфигурацию..."

if [[ -z "$LOCAL_IP" ]]; then
    bad "Не удалось определить основной IPv4."
    LOCAL_ERROR=1
else
    if ip -4 addr | grep -qw "$LOCAL_IP"; then
        ok "Основной IP $LOCAL_IP присутствует на сервере."
    else
        bad "IP $LOCAL_IP отсутствует на интерфейсах."
        LOCAL_ERROR=1
    fi
fi

# ------------------------------
# 2. Default route
# ------------------------------

if [[ -z "$IFACE" ]]; then
    bad "Нет default route."
    LOCAL_ERROR=1
else
    ok "Default route идёт через $IFACE."
fi

# ------------------------------
# 3. Маршрут до peer
# ------------------------------

echo
info "Проверяю маршрут до $PEER_IP..."

ROUTE=$(ip -4 route get "$PEER_IP" 2>&1)
ROUTE_RC=$?

if [[ $ROUTE_RC -ne 0 ]]; then
    bad "Нет маршрута до $PEER_IP:"
    echo "$ROUTE"
    LOCAL_ERROR=1
else
    echo "    $ROUTE"

    ROUTE_SRC=$(awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}' <<< "$ROUTE")

    if [[ -n "$ROUTE_SRC" && "$ROUTE_SRC" != "$LOCAL_IP" ]]; then
        bad "До второго сервера пакеты идут с IP $ROUTE_SRC, а основной IP — $LOCAL_IP."
        echo "    Возможна проблема source IP / routing / policy routing."
        LOCAL_ERROR=1
    else
        ok "Маршрут использует правильный source IP: $LOCAL_IP"
    fi
fi

# ------------------------------
# 4. Ping
# ------------------------------

echo
info "Проверяю ICMP до $PEER_IP..."

if ping -I "$LOCAL_IP" -c 3 -W 2 "$PEER_IP" >/dev/null 2>&1; then
    ok "$PEER_ROLE отвечает на ping."
    PING_OK=1
else
    warn "$PEER_ROLE не отвечает на ping."
    echo "    Это ещё НЕ значит, что сервер мёртв: ICMP может быть закрыт."
    PING_OK=0
fi

# ------------------------------
# 5. TCP порт
# ------------------------------

TCP_RESULT="SKIP"

if [[ -n "$SERVICE_PORT" ]]; then

    echo
    info "Проверяю TCP $PEER_IP:$SERVICE_PORT..."

    if command -v nc >/dev/null 2>&1; then

        NC_OUT=$(nc -vz -w 4 -s "$LOCAL_IP" "$PEER_IP" "$SERVICE_PORT" 2>&1)
        NC_RC=$?

        echo "    $NC_OUT"

        if [[ $NC_RC -eq 0 ]]; then
            ok "TCP-порт $SERVICE_PORT доступен."
            TCP_RESULT="OPEN"

        elif grep -qi "refused" <<< "$NC_OUT"; then
            warn "Сервер доступен, но порт $SERVICE_PORT отклоняет соединение."
            echo "    Сеть до сервера работает."
            echo "    Скорее всего сервис не запущен или не слушает этот порт."
            PEER_ERROR=1
            TCP_RESULT="REFUSED"

        else
            bad "TCP-соединение не устанавливается."
            TCP_RESULT="TIMEOUT"
        fi

    else

        warn "netcat (nc) не установлен."
        info "Пробую через bash /dev/tcp..."

        if timeout 5 bash -c \
            "exec 3<>/dev/tcp/$PEER_IP/$SERVICE_PORT" \
            >/dev/null 2>&1; then

            ok "TCP-порт $SERVICE_PORT доступен."
            TCP_RESULT="OPEN"
        else
            bad "TCP-порт $SERVICE_PORT недоступен."
            TCP_RESULT="TIMEOUT"
        fi
    fi
fi

# ------------------------------
# 6. Traceroute / tracepath
# ------------------------------

echo
info "Проверяю путь..."

if command -v tracepath >/dev/null 2>&1; then
    tracepath -n "$PEER_IP" 2>/dev/null | head -n 12
elif command -v traceroute >/dev/null 2>&1; then
    traceroute -n -w 1 -q 1 "$PEER_IP" 2>/dev/null | head -n 12
else
    warn "tracepath/traceroute не установлен."
fi

# ------------------------------
# Результат
# ------------------------------

echo
echo "======================================"
echo "              ДИАГНОЗ"
echo "======================================"
echo

if [[ "$TCP_RESULT" == "OPEN" ]]; then

    ok "Связь $LOCAL_ROLE -> $PEER_ROLE работает."
    echo
    echo "Сетевой маршрут и TCP-соединение исправны."
    echo "Если сама связка не работает — ищи проблему в:"
    echo "  • конфиге приложения/прокси;"
    echo "  • неправильном порте;"
    echo "  • ACL/firewall конкретного сервиса;"
    echo "  • привязке сервиса к 127.0.0.1 или неправильному IP."

elif [[ "$TCP_RESULT" == "REFUSED" ]]; then

    bad "Проблема, скорее всего, на стороне $PEER_ROLE."
    echo
    echo "$PEER_IP доступен по сети, но порт $SERVICE_PORT закрыт."
    echo
    echo "Проверь на $PEER_ROLE:"
    echo "  ss -lntup | grep :$SERVICE_PORT"
    echo "  systemctl status <имя_сервиса>"
    echo "  nft list ruleset"
    echo "  iptables -L -n -v"

elif [[ "$TCP_RESULT" == "TIMEOUT" && "$PING_OK" -eq 1 ]]; then

    bad "$PEER_ROLE доступен, но TCP-порт $SERVICE_PORT фильтруется."
    echo
    echo "Вероятные причины:"
    echo "  • firewall на $PEER_ROLE;"
    echo "  • firewall/ACL у провайдера;"
    echo "  • сервис слушает только другой IP;"
    echo "  • порт разрешён не для IP $LOCAL_IP."

elif [[ "$LOCAL_ERROR" -eq 1 ]]; then

    bad "Обнаружена проблема на $LOCAL_ROLE ($LOCAL_IP)."
    echo
    echo "Проверь:"
    echo "  ip addr"
    echo "  ip route"
    echo "  ip rule"
    echo "  nft list ruleset"
    echo "  iptables -L -n -v"

elif [[ "$PING_OK" -eq 0 && "$TCP_RESULT" == "TIMEOUT" ]]; then

    warn "Нет ответа ни по ICMP, ни по TCP."
    echo
    echo "Однозначно определить виновника только с этого сервера нельзя."
    echo
    echo "Возможные варианты:"
    echo "  • $LOCAL_ROLE не выпускает трафик;"
    echo "  • неправильный маршрут;"
    echo "  • $PEER_ROLE не принимает трафик;"
    echo "  • firewall между серверами;"
    echo "  • проблема маршрутизации у хостера;"
    echo "  • IP $PEER_IP выключен/не назначен."
    echo
    echo "Для точного определения нужна обратная проверка с $PEER_ROLE -> $LOCAL_IP."

else

    warn "ICMP не отвечает, но критической локальной ошибки не найдено."
    echo
    echo "Укажи порт сервиса при запуске — TCP-проверка даст более точный результат."

fi

echo
echo "======================================"
